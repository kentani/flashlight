{
  "name": "flashlight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "verify:worktree": "node scripts/verify-worktree.js",
    "dev": "yarn verify:worktree && nuxt",
    "dev:isolated": "node scripts/codex-dev.js",
    "build": "yarn verify:worktree && nuxt build",
    "start": "yarn verify:worktree && nuxt start",
    "generate": "yarn verify:worktree && nuxt generate",
    "test": "yarn verify:worktree && jest",
    "test:ci": "yarn verify:worktree && jest --ci --runInBand",
    "test:e2e": "yarn verify:worktree && playwright test",
    "lint": "yarn verify:worktree && eslint pages layouts scripts test/e2e nuxt.config.js jest.config.js playwright.config.js --ext .js,.vue",
    "lint:pwa": "yarn verify:worktree && eslint static/sw.js",
    "generate:check": "yarn verify:worktree && NUXT_GENERATE_DIR=.preview nuxt generate --fail-on-error"
  },
  "dependencies": {
    "@nuxtjs/pwa": "^3.3.5",
    "core-js": "^3.25.3",
    "nuxt": "^2.15.8",
    "vue": "^2.7.10",
    "vue-server-renderer": "^2.7.10",
    "vue-template-compiler": "^2.7.10",
    "vuetify": "^2.6.10"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/vuetify": "^1.12.3",
    "@vue/test-utils": "^1.3.0",
    "@vue/vue2-jest": "^29.2.6",
    "babel-jest": "^29.1.2",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.33.0",
    "jest": "^29.1.2",
    "jest-environment-jsdom": "^29.1.2"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": "22.x"
  }
}
